# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# YouTube台本自動生成システム 環境変数設定
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# このファイルを .env にコピーして、値を設定してください。
#   cp .env.example .env
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── AI API 設定 ──────────────────────────────────────
# "openai" または "anthropic" を指定
AI_PROVIDER=openai

# OpenAI API キー（AI_PROVIDER=openai の場合に必須）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 使用するモデル（デフォルト: gpt-4o）
OPENAI_MODEL=gpt-4o

# Anthropic API キー（AI_PROVIDER=anthropic の場合に必須）
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── メール設定 ───────────────────────────────────────
# "gmail_api" または "smtp" を指定
EMAIL_METHOD=gmail_api

# 台本を送信するメールアドレス（必須）
RECIPIENT_EMAIL=your-email@example.com

# Gmail API で送信元として使うアドレス（gmail_api の場合に必須）
SENDER_EMAIL=your-gmail@gmail.com

# Gmail API 認証ファイルのパス（デフォルトはプロジェクトルート）
# GMAIL_CREDENTIALS_FILE=./credentials.json
# GMAIL_TOKEN_FILE=./token.json

# ── SMTP 設定（EMAIL_METHOD=smtp の場合） ──────────────
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── テーマ管理 ───────────────────────────────────────
# 直近何日分のテーマ重複を避けるか（デフォルト: 7）
# TOPIC_LOOKBACK_DAYS=7
